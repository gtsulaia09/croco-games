// The web app as a static-assets Worker (Cloudflare's successor to Pages):
// https://croco-games.giowulaia76.workers.dev. Build first (`vite build` with the VITE_* values),
// then `wrangler deploy` from this folder. `dist/_headers` (CSP, HSTS, …) is applied by Cloudflare.
{
  "name": "croco-games",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
