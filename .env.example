# Croco Games — Environment Variables Example
# Copy values into your local environment or CI/Cloudflare configuration.
# NEVER commit real credentials, private keys, or `.env` / `.dev.vars` files.

# -----------------------------------------------------------------------------
# Frontend (apps/web) — PUBLIC values only (compiled into the browser bundle)
# Every VITE_* variable is visible to end users. Never put secrets here.
# -----------------------------------------------------------------------------
VITE_API_BASE=http://127.0.0.1:8787
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# "true" shows the Facebook login button (only after Facebook is enabled in Firebase Authentication)
VITE_FACEBOOK_LOGIN=
# Optional Cloudflare Turnstile site key (public). Leave empty to disable widget.
VITE_TURNSTILE_SITE_KEY=
# Deployment target: "cloudflare-pages" (default) or "github-pages" (demo only)
VITE_DEPLOYMENT=cloudflare-pages
# Base path for subpath deployments (e.g. "/croco-games/" on GitHub Pages)
VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# Backend Worker (apps/worker) — Public vars live in wrangler.toml [vars].
# Secrets below MUST be set via `wrangler secret put <NAME> --env <env>`
# (or local-only `apps/worker/.dev.vars`, which is gitignored).
# -----------------------------------------------------------------------------
# 32 random bytes, base64url-encoded (encrypts Admin TOTP secrets at rest with AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY

# ≥32 random chars (HMAC pepper for one-time Admin recovery codes)
RECOVERY_CODE_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# ≥32 random chars (HMAC key for pseudonymising IP addresses in logs/events)
IP_HASH_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Verified Firebase UID + verified email of the initial platform administrator
# Admin endpoints remain disabled (fail closed) until ALL four admin secrets are set.
ADMIN_FIREBASE_UID=REPLACE_WITH_OWNER_FIREBASE_UID
ADMIN_BOOTSTRAP_EMAIL=owner@example.com

# Optional Cloudflare Turnstile secret key (server-side verification of profile creation)
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
